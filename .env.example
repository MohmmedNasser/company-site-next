NEXT_PUBLIC_DATA_SOURCE=mock

# Base URL of the Laravel API (including /api/v1, no trailing slash).
# Only used when NEXT_PUBLIC_DATA_SOURCE=api; ignored while it is "mock".
# Local example: http://company-site-api.test/api/v1
NEXT_PUBLIC_API_URL=

# Production site URL used to build absolute canonical/OG URLs
# (Next.js metadataBase). Defaults to http://localhost:3000 if unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
